<%- include('partials/header') %>

<h2>글쓰기</h2>

<form action="/posts" method="POST">
    <div>
        <label for="title">제목</label>
        <input
            type="text"
            id="title"
            name="title"
            required
        >
    </div>

    <div>
        <label for="author">작성자</label>
        <input
            type="text"
            id="author"
            name="author"
            required
        >
    </div>

    <div>
        <label for="content">내용</label>
        <textarea
            id="content"
            name="content"
            rows="5"
            required
        ></textarea>
    </div>

    <button type="submit">작성하기</button>
</form>

<a href="/posts">목록으로</a>

<%- include('partials/footer') %>